pageType: content
background:
  type: solid
  color: "$paper"
elements:
  - elementId: kicker
    elementType: text
    bounds: [80, 50, 700, 20]
    content:
      style: "$kicker"
      wrap: false
      text: |
        <p>INNOVATION 04 · 体验峰值</p>
  - elementId: title
    elementType: text
    bounds: [80, 78, 1120, 44]
    content:
      style: "$title"
      wrap: false
