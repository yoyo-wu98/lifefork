# Public beta
LIFEFORK_AI_ENABLED=true
LIFEFORK_AI_PROVIDER=openai
LIFEFORK_VERSION=0.8.2
LIFEFORK_COOKIE_SECURE=true
LIFEFORK_CONFIG_PATH=/app/data/runtime-config.json

# Generate both values with a password manager before deployment.
LIFEFORK_SESSION_SECRET=
LIFEFORK_ADMIN_PASSWORD=

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium

# DeepSeek can be selected with LIFEFORK_AI_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Keep disabled in public environments. It can expose provider excerpts in API metadata.
LIFEFORK_AI_DEBUG=false
